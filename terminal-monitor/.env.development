# Dev wiring — routes THROUGH the CRA dev server (src/setupProxy.js) instead of
# hitting the Tauri app's API port directly. Calling 42031/42051 cross-origin
# from the browser gets a 403 from termflow-core's CORS/origin allowlist (it
# only trusts the real app's own origins, not this monitor's :3000). Same-origin
# requests to :3000 have no such restriction, and setupProxy.js forwards them
# to the API port after stripping Origin/Referer so termflow-core sees them as
# provenance-less (same as curl), which its loopback API already allows.
#
# Auto-loaded by `react-scripts start` (i.e. `bun run start`) in development.
# No secrets here — localhost mode leaves the API open (auth is enforced only
# when "expose on network" is enabled), so no token is required.
# /api/ws, not /ws — webpack-dev-server's own HMR client owns bare /ws on :3000.
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000/api/ws
